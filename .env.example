# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real credentials.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key. Never prefix with NEXT_PUBLIC_ and never import it in client code.
# Used only by the seed script (`npm run seed`), which runs in Node and bypasses RLS.
# Paste the legacy "service_role" key or a new "sb_secret_..." secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Teacher account used by Playwright end-to-end tests (created in Supabase Auth -> Users)
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
